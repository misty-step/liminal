#!/usr/bin/env bash
# verify-liminal: build, launch, check and drive Liminal the way a player does.
# Run from anywhere inside the liminal checkout. `verify-liminal help` lists commands.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
REPO="$(git -C "$SCRIPT_DIR" rev-parse --show-toplevel)"
STATE="${VERIFY_LIMINAL_STATE:-${XDG_CACHE_HOME:-$HOME/.cache}/tmp/verify-liminal}"
PROD="https://liminal.mistystep.io"
WRANGLER=(bunx --no-install wrangler)

die() { printf 'verify-liminal: %s\n' "$*" >&2; exit 1; }
say() { printf '%s\n' "$*" >&2; }

usage() {
  cat <<'EOF'
verify-liminal build                  Build the Worker bundle (.open-next/bundle) from this checkout.
verify-liminal launch [--judge]       Start a local production-mode Worker on disposable D1.
                                      Default instance "offline" has no judge key (outage path).
                                      --judge starts instance "judge" with the live judge; it needs
                                      OPENROUTER_API_KEY or TYPESAFE_API_KEY in the environment.
verify-liminal base <instance>        Print the URL of a launched instance (offline | judge).
verify-liminal doctor <target>        Read-only health check. Target: prod | offline | judge | <URL>.
verify-liminal journey <target> [--live-judge]
                                      Read-only player journey with screenshots. Safe on prod.
                                      --live-judge also places novel words (loopback targets only).
verify-liminal qa                     Repository write journeys (reports, storage) on "offline".
verify-liminal cleanup [<instance>|--all]
                                      Stop instances this tool started; delete their scratch D1.
                                      Evidence is never removed.
Evidence goes to $OUT, default evidence/verify-liminal/<UTC date>/<target>/ in the checkout.
EOF
}

instance_dir() { printf '%s/%s' "$STATE" "$1"; }

alive() { [[ -f "$1/pid" ]] && kill -0 "$(cat "$1/pid")" 2>/dev/null; }

resolve_target() {
  case "${1:-}" in
    prod | production) printf '%s' "$PROD" ;;
    offline | judge)
      local dir
      dir="$(instance_dir "$1")"
      alive "$dir" || die "instance $1 is not running; run: verify-liminal launch$([[ $1 == judge ]] && printf ' --judge')"
      cat "$dir/base"
      ;;
    http://* | https://*) printf '%s' "${1%/}" ;;
    *) die "unknown target '${1:-}' (prod | offline | judge | <URL>)" ;;
  esac
}

target_label() {
  case "$1" in
    prod | production) printf 'prod' ;;
    offline | judge) printf 'local-%s' "$1" ;;
    *) printf 'custom' ;;
  esac
}

evidence_dir() {
  local out="${OUT:-$REPO/evidence/verify-liminal/$(date -u +%F)/$1}"
  mkdir -p "$out"
  (cd "$out" && pwd -P)
}

is_loopback() {
  local host
  host="$(printf '%s' "$1" | sed -E 's#^https?://\[?([^]/:]+)\]?.*#\1#')"
  [[ $host == 127.0.0.1 || $host == localhost || $host == ::1 ]]
}

cmd_build() {
  cd "$REPO"
  local sha
  sha="$(git rev-parse HEAD)"
  bun install --frozen-lockfile
  # Local verification builds: no browser Sentry or PostHog keys, so the
  # production build guard stays off and no synthetic telemetry leaves the box.
  env -u NEXT_PUBLIC_SENTRY_ENVIRONMENT -u SENTRY_ENVIRONMENT -u NEXT_PUBLIC_SENTRY_DSN \
    -u NEXT_PUBLIC_POSTHOG_KEY -u SENTRY_DSN -u SENTRY_AUTH_TOKEN \
    NEXT_TELEMETRY_DISABLED=1 NEXT_PUBLIC_SENTRY_RELEASE="$sha" SENTRY_RELEASE="$sha" \
    bun run build:cf
  printf '%s\n' "$sha" >.open-next/SOURCE_SHA
  env -u CLOUDFLARE_API_TOKEN "${WRANGLER[@]}" deploy --env production --dry-run \
    --outdir .open-next/bundle >/dev/null
  say "built .open-next/bundle at $sha"
}

free_port() { python3 -c 'import socket; s=socket.socket(); s.bind(("127.0.0.1",0)); print(s.getsockname()[1])'; }

cmd_launch() {
  local name=offline
  [[ ${1:-} == --judge ]] && name=judge
  cd "$REPO"
  [[ -f .open-next/bundle/worker.js ]] || die "no bundle; run: verify-liminal build"
  [[ "$(cat .open-next/SOURCE_SHA 2>/dev/null)" == "$(git rev-parse HEAD)" ]] ||
    say "warning: bundle was built from $(cat .open-next/SOURCE_SHA 2>/dev/null || echo unknown), HEAD is $(git rev-parse HEAD); rebuild to verify HEAD"
  local dir
  dir="$(instance_dir "$name")"
  alive "$dir" && die "instance $name already running at $(cat "$dir/base"); cleanup first"
  rm -rf "$dir"
  mkdir -p "$dir"
  chmod 700 "$dir"

  # Deploy, generator and telemetry credentials never reach a local rehearsal.
  local -a strip=(-u CLOUDFLARE_API_TOKEN -u LIMINAL_GENERATOR_API_KEY -u SENTRY_DSN -u SENTRY_AUTH_TOKEN)
  local -a extra=()
  if [[ $name == judge ]]; then
    [[ -n ${OPENROUTER_API_KEY:-}${TYPESAFE_API_KEY:-} ]] ||
      die "--judge needs the judge key, e.g. pass-env run -e OPENROUTER_API_KEY=workstation/OPENROUTER_MISTY_STEP_LIMINAL_SHARED_JUDGMENT_API_KEY -- verify-liminal launch --judge"
    # Wrangler reads Worker secrets from an env file; keep it private and delete it at cleanup.
    (umask 077 && {
      [[ -n ${OPENROUTER_API_KEY:-} ]] && printf 'OPENROUTER_API_KEY=%s\n' "$OPENROUTER_API_KEY"
      [[ -n ${TYPESAFE_API_KEY:-} ]] && printf 'TYPESAFE_API_KEY=%s\n' "$TYPESAFE_API_KEY"
      true
    } >"$dir/judge.env")
    extra=(--env-file "$dir/judge.env")
  else
    strip+=(-u OPENROUTER_API_KEY -u TYPESAFE_API_KEY)
    # An empty env file stops wrangler from loading a developer's .dev.vars/.env.
    : >"$dir/judge.env"
    extra=(--env-file "$dir/judge.env")
  fi

  env "${strip[@]}" "${WRANGLER[@]}" d1 migrations apply LIMINAL_DB --env production --local \
    --persist-to "$dir/d1" >"$dir/migrate.log" 2>&1 || die "D1 migrations failed; see $dir/migrate.log"

  local port base
  port="$(free_port)"
  base="http://127.0.0.1:$port"
  setsid env "${strip[@]}" "${WRANGLER[@]}" dev .open-next/bundle/worker.js --env production \
    --no-bundle --local --persist-to "$dir/d1" --ip 127.0.0.1 --port "$port" \
    --inspector-port 0 --show-interactive-dev-session=false "${extra[@]}" \
    >"$dir/worker.log" 2>&1 </dev/null &
  printf '%s\n' "$!" >"$dir/pid"
  printf '%s\n' "$base" >"$dir/base"

  # A cold Worker can take a minute to answer its first request on a busy
  # machine, so each probe waits long and the whole budget is generous.
  local health="" deadline=$((SECONDS + ${VERIFY_LIMINAL_READY_SECONDS:-300}))
  while ((SECONDS < deadline)); do
    alive "$dir" || { tail -n 20 "$dir/worker.log" >&2; stop_instance "$name"; die "worker exited; its log is above"; }
    health="$(curl -fsS --max-time 60 "$base/api/health" 2>/dev/null || true)"
    if [[ -n $health ]] && printf '%s' "$health" | python3 -c '
import json, sys
h = json.load(sys.stdin)
sys.exit(0 if h.get("status") == "ok" and h.get("checks") == {"deck": "ok", "storage": "ok"} else 1)'; then
      say "instance $name ready (pid $(cat "$dir/pid"))"
      printf '%s\n' "$base"
      return 0
    fi
    sleep 1
  done
  tail -n 20 "$dir/worker.log" >&2 || true
  stop_instance "$name"
  die "instance $name never became healthy within ${VERIFY_LIMINAL_READY_SECONDS:-300}s; stopped it"
}

cmd_base() { resolve_target "${1:?instance: offline | judge}"; printf '\n'; }

cmd_doctor() {
  local target="${1:?target: prod | offline | judge | <URL>}"
  local base
  base="$(resolve_target "$target")"
  local expected=""
  case "$target" in
    prod | production) expected="$(git -C "$REPO" ls-remote origin refs/heads/master | cut -f1)" ;;
    offline | judge) expected="$(cat "$REPO/.open-next/SOURCE_SHA" 2>/dev/null || true)" ;;
  esac
  local fail=0
  if [[ $target == offline || $target == judge ]]; then
    local dir
    dir="$(instance_dir "$target")"
    local listener
    listener="$(ss -ltnpH "sport = :${base##*:}" 2>/dev/null || true)"
    if [[ -n $listener ]]; then
      printf 'ok    port %s is listening (instance %s, pid %s)\n' "${base##*:}" "$target" "$(cat "$dir/pid")"
    else
      printf 'FAIL  nothing listens on %s\n' "$base"
      fail=1
    fi
  fi
  if [[ $target == prod || $target == production ]]; then
    local redirect
    redirect="$(curl -sS -o /dev/null -w '%{http_code} %{redirect_url}' --max-time 10 "http://liminal.mistystep.io/" || true)"
    if [[ $redirect == "308 https://liminal.mistystep.io/" ]]; then
      printf 'ok    plain HTTP redirects with 308 to HTTPS\n'
    else
      printf 'FAIL  plain HTTP redirect is "%s", expected "308 https://liminal.mistystep.io/"\n' "$redirect"
      fail=1
    fi
  fi
  BASE="$base" EXPECTED_REVISION="$expected" python3 - <<'PY' || fail=1
import json, os, sys, urllib.error, urllib.request
from datetime import date, datetime, timezone

base = os.environ["BASE"]
expected = os.environ.get("EXPECTED_REVISION", "")
failed = False

def get(path):
    request = urllib.request.Request(base + path, headers={"user-agent": "verify-liminal"})
    try:
        with urllib.request.urlopen(request, timeout=60) as response:
            return response.status, json.load(response)
    except urllib.error.HTTPError as error:
        return error.code, None

def report(ok, message):
    global failed
    failed |= not ok
    print(("ok    " if ok else "FAIL  ") + message)

status, health = get("/api/health")
health = health or {}
report(status == 200 and health.get("status") == "ok",
       f"/api/health {status} status={health.get('status')} checks={health.get('checks')}")
report(health.get("environment") == "production", f"environment={health.get('environment')}")
revision = health.get("revision")
if expected:
    report(revision == expected, f"revision={revision} expected={expected}")
else:
    print(f"info  revision={revision} version={health.get('version')}")

today = datetime.now(timezone.utc).date()
number = (today - date(2026, 9, 23)).days + 1
status, payload = get("/api/today")
payload = payload or {}
puzzle = payload.get("puzzle") or {}
report(status == 200 and payload.get("date") == today.isoformat() and payload.get("number") == number,
       f"/api/today {status} date={payload.get('date')} number={payload.get('number')} expected {today} #{number}")
labels = [c.get("text") for c in puzzle.get("conditions", [])]
report(len(labels) == 3 and all(labels), f"today's circles: {labels}")
report(puzzle.get("judgeStatus") == "calibrated", f"judgeStatus={puzzle.get('judgeStatus')}")
status, _ = get(f"/api/puzzle/{number + 1}")
report(status == 404, f"/api/puzzle/{number + 1} (tomorrow) answers {status}, expected 404")
sys.exit(1 if failed else 0)
PY
  return "$fail"
}

cmd_journey() {
  local target="${1:?target: prod | offline | judge | <URL>}"
  shift
  local live=0
  [[ ${1:-} == --live-judge ]] && live=1
  local base out
  base="$(resolve_target "$target")"
  if ((live)) && ! is_loopback "$base"; then
    die "--live-judge writes judgments and spends judge credit; it runs only on a local instance"
  fi
  out="$(evidence_dir "$(target_label "$target")")"
  say "journey on $base -> $out"
  (cd "$REPO" && BASE="$base" OUT="$out" LIVE_JUDGE="$live" bun "$SCRIPT_DIR/journey.ts")
}

cmd_qa() {
  local base out
  base="$(resolve_target offline)"
  out="$(evidence_dir local-offline)"
  cd "$REPO"
  # qa-journeys files a real report and expects the judge to be unreachable,
  # so it runs only against the disposable offline instance.
  BASE="$base" OUTAGE_BASE="$base" OUT="$out/qa-journeys" bun e2e/qa-journeys.ts
  BASE="$base" OUT="$out/local-storage" bun e2e/local-storage.ts
}

stop_instance() {
  local name="$1" dir
  dir="$(instance_dir "$name")"
  [[ -d $dir ]] || return 0
  if alive "$dir"; then
    local pid
    pid="$(cat "$dir/pid")"
    # setsid made the worker its own process group; stop only that group.
    kill -TERM -- "-$pid" 2>/dev/null || kill -TERM "$pid" 2>/dev/null || true
    for _ in $(seq 1 20); do kill -0 "$pid" 2>/dev/null || break; sleep 0.5; done
    kill -0 "$pid" 2>/dev/null && kill -KILL -- "-$pid" 2>/dev/null || true
  fi
  rm -rf "$dir"
  say "cleaned instance $name"
}

cmd_cleanup() {
  case "${1:---all}" in
    --all) stop_instance offline; stop_instance judge ;;
    offline | judge) stop_instance "$1" ;;
    *) die "cleanup takes offline, judge or --all" ;;
  esac
}

main() {
  local command="${1:-help}"
  shift || true
  case "$command" in
    build) cmd_build "$@" ;;
    launch) cmd_launch "$@" ;;
    base) cmd_base "$@" ;;
    doctor) cmd_doctor "$@" ;;
    journey) cmd_journey "$@" ;;
    qa) cmd_qa "$@" ;;
    cleanup) cmd_cleanup "$@" ;;
    help | -h | --help) usage ;;
    *) usage >&2; exit 2 ;;
  esac
}

main "$@"
