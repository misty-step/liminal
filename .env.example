# Runtime identity (required in staging and production)
LIMINAL_ENVIRONMENT=staging

# Sentry runtime capture (DSN is configured out of band)
SENTRY_DSN=
SENTRY_ENVIRONMENT=staging
SENTRY_RELEASE=

# Sentry client capture (public DSN, injected at build time)
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=staging
NEXT_PUBLIC_SENTRY_RELEASE=

# Source-map upload (release CI only)
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=liminal

# Semantic judge (server-side secret configured out of band)
JEV_MODEL=typesafe/jev-1.13
JEV_DECISIONS_URL=https://openrouter.ai/api/alpha/decisions
