{
  "name": "liminal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:cf": "opennextjs-cloudflare build",
    "preview:cf": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy:cf": "wrangler deploy --env production",
    "start": "next start",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "foundation:check": "bun run scripts/foundation-check.ts",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "bun run format:check && bun run lint && bun run foundation:check && bun run type-check && bun run test",
    "validate:live": "bun run scripts/live-matrix.ts",
    "puzzles:promote": "bun run scripts/generator/promote.ts",
    "puzzles:generate": "bun run scripts/generator/generate.ts",
    "puzzles:audit": "bun run scripts/generator/audit.ts",
    "puzzles:review": "bun run scripts/generator/review.ts",
    "puzzles:daily": "bun run scripts/generator/daily.ts"
  },
  "dependencies": {
    "@sentry/nextjs": "10.75.1",
    "cuelume": "^0.2.2",
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@opennextjs/cloudflare": "^1.20.6",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "playwright": "^1.63.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1",
    "wrangler": "^4.134.0"
  },
  "trustedDependencies": [
    "@sentry/cli"
  ]
}
