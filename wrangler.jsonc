{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "liminal",
  "account_id": "b069014f6a46558ea9146fb6c4ff8f6c",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-17",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "send_metrics": false,
  "observability": { "enabled": true },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Durable authority (D1): first-writer-wins versioned judgments + append-only reports.
  "d1_databases": [
    {
      "binding": "LIMINAL_DB",
      "database_name": "liminal-judgments",
      "database_id": "24c4f358-7bf1-4ad6-a19a-66802509482b"
    }
  ],
  "env": {
    "staging": {
      "name": "liminal-staging",
      "workers_dev": true,
      "vars": {
        "JEV_MODEL": "typesafe/jev-1.13",
        "JEV_DECISIONS_URL": "https://openrouter.ai/api/alpha/decisions"
      }
    },
    "production": {
      "name": "liminal",
      "workers_dev": false,
      "routes": [{ "pattern": "liminal.mistystep.io", "custom_domain": true }],
      "vars": {
        "JEV_MODEL": "typesafe/jev-1.13",
        "JEV_DECISIONS_URL": "https://openrouter.ai/api/alpha/decisions"
      }
    }
  }
}